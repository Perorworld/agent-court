# =====================================================================
# 1) GEN FLOW (npm run demo:gen) — the main flow. Payment is in GEN.
# =====================================================================
GENLAYER_NETWORK=studionet
ADJUDICATOR_ADDRESS=0xa4CA829658fdF8Ece71d760d0E918bd649A48dae
# Amount the buyer locks, in GEN
ESCROW_AMOUNT_GEN=0.01
# Buyer key must hold GEN (Studio 💧 faucet). Seller key is optional (a throwaway one is made if empty).
BUYER_PK=
SELLER_PK=

# =====================================================================
# 2) YELLOW FLOW — only for non-GEN assets (npm run demo / npm run settle).
#    Not needed for GEN. Leave empty and it runs as a labelled simulation.
# =====================================================================
COURT_PK=
YELLOW_WS_URL=wss://nitronode-sandbox.yellow.org/v1/ws
YELLOW_CHAIN_ID=
YELLOW_RPC_URL=
YELLOW_ASSET=usdc
ESCROW_AMOUNT=10
